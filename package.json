{
    "private": true,
    "type": "module",
    "scripts": {
        "setup": "composer install && php -r \"file_exists('.env') || copy('.env.example', '.env');\" && php artisan key:generate && php artisan migrate:fresh --seed",
        "dev": "php artisan serve",
        "start": "php artisan serve",
        "db:fresh": "php artisan migrate:fresh --seed",
        "update": "composer install && php artisan optimize:clear && php artisan migrate:fresh --seed",
        "clear": "php artisan optimize:clear",
        "routes": "php artisan route:list --except-vendor",
        "vite:dev": "vite",
        "build": "vite build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.0.11"
    }
}
